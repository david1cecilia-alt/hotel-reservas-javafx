<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reservas.ReservasController">
   <padding>
      <Insets top="12.0" right="12.0" bottom="12.0" left="12.0" />
   </padding>
   <children>
      <Label fx:id="lblHotel" text="Hotel" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

      <!-- Buscador de habitaciones -->
      <HBox spacing="8.0" alignment="CENTER_LEFT">
         <children>
            <Label text="N.º de habitación:" />
            <TextField fx:id="txtNumero" promptText="Ej: 112" prefWidth="120.0" onAction="#buscar" />
            <Button text="Buscar" defaultButton="true" onAction="#buscar" />
         </children>
      </HBox>
      <Label fx:id="lblResultado" text="Introduce un número y pulsa «Buscar»." wrapText="true" />

      <Label text="Habitaciones" style="-fx-font-weight: bold;" />
      <TableView fx:id="tablaHabitaciones" prefHeight="220.0">
         <columns>
            <TableColumn text="Número"><cellValueFactory><PropertyValueFactory property="numero" /></cellValueFactory></TableColumn>
            <TableColumn text="Tipo"><cellValueFactory><PropertyValueFactory property="tipo" /></cellValueFactory></TableColumn>
            <TableColumn text="Capacidad"><cellValueFactory><PropertyValueFactory property="capacidad" /></cellValueFactory></TableColumn>
            <TableColumn text="Precio/noche (€)"><cellValueFactory><PropertyValueFactory property="precio" /></cellValueFactory></TableColumn>
            <TableColumn text="Planta"><cellValueFactory><PropertyValueFactory property="planta" /></cellValueFactory></TableColumn>
            <TableColumn text="Vista"><cellValueFactory><PropertyValueFactory property="vista" /></cellValueFactory></TableColumn>
            <TableColumn text="Accesible"><cellValueFactory><PropertyValueFactory property="accesible" /></cellValueFactory></TableColumn>
            <TableColumn text="Estado"><cellValueFactory><PropertyValueFactory property="estado" /></cellValueFactory></TableColumn>
         </columns>
      </TableView>

      <Label text="Reservas de la habitación buscada" style="-fx-font-weight: bold;" />
      <TableView fx:id="tablaReservas" prefHeight="180.0">
         <columns>
            <TableColumn text="Código"><cellValueFactory><PropertyValueFactory property="codigo" /></cellValueFactory></TableColumn>
            <TableColumn text="Cliente"><cellValueFactory><PropertyValueFactory property="cliente" /></cellValueFactory></TableColumn>
            <TableColumn text="Email"><cellValueFactory><PropertyValueFactory property="email" /></cellValueFactory></TableColumn>
            <TableColumn text="Habitación"><cellValueFactory><PropertyValueFactory property="habitacion" /></cellValueFactory></TableColumn>
            <TableColumn text="Entrada"><cellValueFactory><PropertyValueFactory property="entrada" /></cellValueFactory></TableColumn>
            <TableColumn text="Salida"><cellValueFactory><PropertyValueFactory property="salida" /></cellValueFactory></TableColumn>
            <TableColumn text="Personas"><cellValueFactory><PropertyValueFactory property="personas" /></cellValueFactory></TableColumn>
            <TableColumn text="Estado"><cellValueFactory><PropertyValueFactory property="estado" /></cellValueFactory></TableColumn>
         </columns>
      </TableView>
   </children>
</VBox>
